generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  loginid      String    @unique
  username     String
  deptname     String
  businessUnit String
  teamId       String?
  groupId      String?
  partId       String?
  requestCount Int       @default(0)
  preferences  Json?     // { tone?, language?, emphasis?, customInstructions? }
  createdAt    DateTime  @default(now())
  lastActive   DateTime  @default(now())

  team         Team?     @relation(fields: [teamId], references: [id])
  group        Group?    @relation(fields: [groupId], references: [id])
  part         Part?     @relation(fields: [partId], references: [id])

  workLogs     WorkLog[]
  todos        Todo[]
  ratings      LLMRating[]
  teamAdmins   TeamAdmin[]
  orgAdmins    OrgAdmin[]
  activityLogs ActivityLog[]
  announcements Announcement[]

  @@map("users")
}

model Team {
  id           String    @id @default(uuid())
  name         String
  businessUnit String
  createdAt    DateTime  @default(now())

  users        User[]
  groups       Group[]
  spaces       Space[]
  tags         Tag[]
  teamAdmins   TeamAdmin[]
  reportJobs   ReportJob[]
  reportLogs   ReportLog[]
  announcements Announcement[]

  @@unique([name, businessUnit])
  @@map("teams")
}

model Group {
  id        String   @id @default(uuid())
  name      String
  teamId    String
  createdAt DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  parts     Part[]
  users     User[]

  @@unique([name, teamId])
  @@map("groups")
}

model Part {
  id        String   @id @default(uuid())
  name      String
  groupId   String
  createdAt DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  users     User[]

  @@unique([name, groupId])
  @@map("parts")
}

model Space {
  id        String    @id @default(uuid())
  type      SpaceType
  ownerId   String
  teamId    String?
  createdAt DateTime  @default(now())

  team      Team?     @relation(fields: [teamId], references: [id])

  workLogs  WorkLog[]
  todos     Todo[]
  reports   Report[]

  @@index([type, ownerId])
  @@map("spaces")
}

enum SpaceType {
  PERSONAL
  PART
  GROUP
  TEAM
}

// 기존 Item -> WorkLog (업무 기록)
model WorkLog {
  id           String   @id @default(uuid())
  userId       String
  spaceId      String
  title        String
  content      String
  link         String?
  date         DateTime @db.Date
  linkedItemId String?  // 파트 Item(목표)에 LLM 자동 연결
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id])
  space        Space    @relation(fields: [spaceId], references: [id])
  linkedItem   Item?    @relation(fields: [linkedItemId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([spaceId, date])
  @@map("work_logs")
}

// 조직 목표
model Item {
  id           String     @id @default(uuid())
  title        String
  content      String     @default("")
  status       ItemStatus @default(PLANNED)
  startDate    DateTime?  @db.Date
  endDate      DateTime?  @db.Date
  progress     Int        @default(0) // 0-100
  summary      String?    // LLM 자동 진척사항
  level        OrgLevel
  ownerId      String     // teamId / groupId / partId
  parentItemId String?    // 상위 Item FK
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  parentItem   Item?      @relation("ItemHierarchy", fields: [parentItemId], references: [id], onDelete: SetNull)
  childItems   Item[]     @relation("ItemHierarchy")
  itemTags     ItemTag[]
  linkedWorkLogs WorkLog[]
  linkedTodos  Todo[]

  @@index([level, ownerId])
  @@index([parentItemId])
  @@map("goals")
}

enum ItemStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum OrgLevel {
  TEAM
  GROUP
  PART
}

// 개인 할일
model Todo {
  id           String    @id @default(uuid())
  userId       String
  spaceId      String
  title        String
  content      String    @default("")
  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date
  completed    Boolean   @default(false)
  completedAt  DateTime?
  linkedItemId String?   // 파트 Item에 LLM 자동 연결

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id])
  space        Space     @relation(fields: [spaceId], references: [id])
  linkedItem   Item?     @relation(fields: [linkedItemId], references: [id], onDelete: SetNull)

  @@index([userId, completed])
  @@index([spaceId])
  @@map("todos")
}

// 목표 분류 태그
model Tag {
  id        String   @id @default(uuid())
  name      String
  teamId    String
  createdAt DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  itemTags  ItemTag[]

  @@unique([name, teamId])
  @@map("tags")
}

// Item-Tag M:N
model ItemTag {
  id     String @id @default(uuid())
  itemId String
  tagId  String

  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([itemId, tagId])
  @@map("item_tags")
}

// 조직 관리 권한
model OrgAdmin {
  id        String   @id @default(uuid())
  userId    String
  level     OrgLevel
  targetId  String   // teamId / groupId / partId
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, level, targetId])
  @@map("org_admins")
}

model Report {
  id               String     @id @default(uuid())
  spaceId          String
  type             ReportType
  byMemberContent  String
  byItemContent    String
  progressContent  String?    // 목표 진행률 섹션
  periodStart      DateTime   @db.Date
  periodEnd        DateTime   @db.Date
  createdAt        DateTime   @default(now())
  expiresAt        DateTime

  space            Space      @relation(fields: [spaceId], references: [id])

  @@index([spaceId, createdAt])
  @@map("reports")
}

enum ReportType {
  PERSONAL
  PART
  GROUP
  TEAM
}

model ReportJob {
  id         String        @id @default(uuid())
  teamId     String
  status     ReportJobStatus
  failedAt   String?
  retryCount Int           @default(0)
  lastError  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  team       Team          @relation(fields: [teamId], references: [id])

  @@index([teamId, status])
  @@map("report_jobs")
}

enum ReportJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model LLMConfig {
  id         String   @id @default(uuid())
  endpoint   String
  apiKey     String
  modelId    String
  modelName  String
  isActive   Boolean  @default(false)
  lastSyncAt DateTime?
  createdAt  DateTime @default(now())

  @@map("llm_configs")
}

model LLMRating {
  id           String   @id @default(uuid())
  userId       String
  score        Int
  requestCount Int
  modelId      String
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])

  @@map("llm_ratings")
}

model TeamAdmin {
  id        String   @id @default(uuid())
  userId    String
  teamId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  team      Team     @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
  @@map("team_admins")
}

model ReportLog {
  id           String          @id @default(uuid())
  teamId       String
  reportType   ReportType
  targetName   String
  status       ReportLogStatus
  errorMessage String?
  createdAt    DateTime        @default(now())

  team         Team            @relation(fields: [teamId], references: [id])

  @@index([teamId, createdAt])
  @@map("report_logs")
}

enum ReportLogStatus {
  SUCCESS
  FAILED
}

model Announcement {
  id        String   @id @default(uuid())
  teamId    String   @unique
  authorId  String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team      Team     @relation(fields: [teamId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])

  @@map("announcements")
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  targetType String?
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("activity_logs")
}
