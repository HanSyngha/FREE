# FREE - Docker Environment
# Copy to .env and fill in the values

# Proxy (Samsung DS network)
HTTP_PROXY=http://12.26.204.100:8000
HTTPS_PROXY=http://12.26.204.100:8000
NO_PROXY=localhost,127.0.0.1,genai.samsungds.net,a2g.samsungds.net

# PostgreSQL
POSTGRES_USER=free
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=free

# JWT Secret (32자 이상 필수)
JWT_SECRET=your_jwt_secret_here_minimum_32_characters

# Encryption Key (32자 이상 필수)
ENCRYPTION_KEY=your_encryption_key_here_minimum_32_characters

# Developers (Super Admin, comma separated loginids)
DEVELOPERS=syngha.han

# LLM Proxy (Dashboard API)
LLM_PROXY_URL=http://a2g.samsungds.net:4090/v1/chat/completions
LLM_SERVICE_ID=free
DASHBOARD_URL=http://a2g.samsungds.net:4090

# SSO
VITE_SSO_URL=https://genai.samsungds.net:36810
