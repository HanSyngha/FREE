# FREE(main) - AWS Environment Template
# 복사: cp .env.example .env

# Domain
DOMAIN=your-ip.nip.io
PUBLIC_URL=https://your-ip.nip.io:6090
PROXY_PORT=6090

# SSL cert path (Dashboard의 certbot 공유)
CERTBOT_CONF_PATH=/home/ubuntu/dashboard/certbot/conf

# Dashboard
DASHBOARD_URL=https://your-ip.nip.io:4090

# PostgreSQL
POSTGRES_USER=free
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=free

# JWT Secret (32자 이상)
JWT_SECRET=your_jwt_secret_here_minimum_32_characters

# Encryption Key (32자 이상)
ENCRYPTION_KEY=your_encryption_key_here_minimum_32_characters

# Developers (Super Admin)
DEVELOPERS=your_admin_id

# LLM Proxy (Dashboard API)
LLM_PROXY_URL=https://your-ip.nip.io:4090/v1/chat/completions
LLM_SERVICE_ID=free

# OAuth
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
